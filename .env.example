# PriceWatch configuration TEMPLATE. This file is committed; it must never hold real values.
#
# DO NOT create .env inside the repository. Put your real config OUTSIDE the project so
# that AI coding agents working in this folder (and `git add .`) can never see it:
#
#   mkdir -p ~/.config/pricewatch
#   cp .env.example ~/.config/pricewatch/pricewatch.env
#   chmod 600 ~/.config/pricewatch/pricewatch.env
#
# Lookup order: $PW_ENV_FILE -> ~/.config/pricewatch/pricewatch.env -> ./.env (discouraged)

# ---------------------------------------------------------------- server
PW_HOST=127.0.0.1
PW_PORT=8765
# Extra hostnames allowed in the Host header (e.g. your Tailscale name), comma-separated.
# Listing any name other than this computer REQUIRES PW_ACCESS_TOKEN (see docs/remote-access.md).
PW_ALLOWED_HOSTS=
# Required if PW_HOST is not loopback or PW_ALLOWED_HOSTS lists another device.
# Set it with: python3 -m pricewatch set-token   [SECRET]
PW_ACCESS_TOKEN=
# Database + data. Default: ~/.local/share/pricewatch
PW_DATA_DIR=

# ---------------------------------------------------------------- checking
PW_MIN_INTERVAL_MINUTES=5
PW_FETCH_TIMEOUT=20
PW_USER_AGENT=
# Keep false. Only for tests: lets the app fetch localhost/private-network URLs.
PW_ALLOW_PRIVATE_HOSTS=false
# Shops that block plain requests (Argos, Currys, Amazon...) are fetched with an installed
# browser running headless with a throw-away profile (never your cookies): Chrome, Edge,
# Brave or Chromium if present, otherwise Firefox. Not available inside the Docker image.
# auto = only when blocked or no price found | always | never
PW_BROWSER_FETCH=auto
# Only if your browser is somewhere unusual
PW_BROWSER_PATH=

# ---------------------------------------------------------------- v2: AI price search agent
# Search backend: none | searxng   (self-hosted, no API key; see docker-compose.yml)
PW_SEARCH_PROVIDER=none
PW_SEARXNG_URL=http://127.0.0.1:8888
# Only needed for the bundled SearXNG container. Generate: openssl rand -hex 32   [SECRET]
SEARXNG_SECRET=
# Matching brain: none (heuristic) | ollama (local, recommended) | openai_compatible | anthropic
PW_LLM_PROVIDER=none
PW_LLM_BASE_URL=http://127.0.0.1:11434
PW_LLM_MODEL=gemma4:e2b
# Only for openai_compatible servers that need one, or anthropic.   [SECRET]
PW_LLM_API_KEY=
PW_AGENT_MAX_CANDIDATES=12
# Automatically re-search every N hours (0 = only when you press the button)
PW_AGENT_INTERVAL_HOURS=0

# ---------------------------------------------------------------- v4: Fair Price
# Anonymous-shopper check per item every N hours (0 = on demand only)
PW_FAIR_INTERVAL_HOURS=24
# % difference treated as "a different price"
PW_FAIR_THRESHOLD_PCT=2
# % above the 30-day median treated as surge pricing
PW_SURGE_THRESHOLD_PCT=15
# Optional extra network exits (e.g. VPN/HTTP proxies in other regions), comma-separated.
# May contain credentials.   [SECRET]
PW_FAIR_PROXIES=

# ---------------------------------------------------------------- licence (AGPL-3.0)
# Where people using this PriceWatch can get its source code (shown in the page footer).
# Only change it if you run a MODIFIED copy for other people: point it at your version's code.
PW_SOURCE_URL=
