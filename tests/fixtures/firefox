#!/usr/bin/env python3
# Fake Firefox speaking the Marionette protocol, to test PriceWatch's client.
import json, os, re, socket, sys
prof = sys.argv[sys.argv.index("--profile") + 1]
assert "--headless" in sys.argv and "--marionette" in sys.argv
port = int(re.search(r'"marionette.port", (\d+)', open(os.path.join(prof, "user.js")).read()).group(1))
srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.1", port)); srv.listen(1)
c, _ = srv.accept()
def send(o):
    b = json.dumps(o).encode(); c.sendall(str(len(b)).encode() + b":" + b)
send({"applicationType": "gecko", "marionetteProtocol": 3})
buf = b""; url = ""
while True:
    while b":" not in buf:
        d = c.recv(4096)
        if not d: sys.exit(0)
        buf += d
    n, _, buf = buf.partition(b":"); n = int(n)
    while len(buf) < n: buf += c.recv(4096)
    msg, buf = json.loads(buf[:n]), buf[n:]
    _, mid, name, params = msg
    if name == "WebDriver:Navigate": url = params["url"]
    res = {"WebDriver:GetPageSource": {"value": "<html><head><title>Fox</title></head><body><h1>Tablet</h1>"
            "<div data-test='product-price-primary'>£699.00</div>" + " " * 300 + "</body></html>"},
           "WebDriver:GetCurrentURL": {"value": url}}.get(name, {})
    # split the reply across two packets to exercise framing
    b = json.dumps([1, mid, None, res]).encode(); frame = str(len(b)).encode() + b":" + b
    c.sendall(frame[:7]); c.sendall(frame[7:])
    if name == "Marionette:Quit": sys.exit(0)
